# Local development: leave DATABASE_URL unset to use the bundled SQLite database at
# backend/database/couplings.db. Only set this in production (Render), pointing at the
# Supabase Postgres connection string.
DATABASE_URL=your_supabase_database_url

# Local development: leave unset - http://localhost:5173 is always allowed. Only set
# this in production (Render) to the deployed Vercel frontend URL, so the browser is
# permitted to call this API cross-origin.
FRONTEND_URL=https://your-vercel-domain.vercel.app
